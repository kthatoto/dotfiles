#!/bin/bash

set -euo pipefail

# 現在のgitリポジトリから元のリポジトリを特定
git_common_dir=$(git rev-parse --git-common-dir 2>/dev/null) || {
    echo "Error: Not in a git repository"
    exit 1
}
original_repo=$(cd "$git_common_dir" && cd .. && pwd)
parent_dir=$(dirname "$original_repo")
base_name=$(basename "$original_repo")

files_to_sync=(".mcp.json")

if [[ -z "${1:-}" ]]; then
    echo "Usage: worktree-sync <branch_name>"
    exit 1
fi

branch_name="$1"

# 空いている連番を探す
for suffix in a b c d e f g h i j; do
    worktree_dir="$parent_dir/${base_name}-${suffix}"
    if [[ ! -d "$worktree_dir" ]]; then
        echo "Creating worktree at $worktree_dir for branch $branch_name..."
        git worktree add "$worktree_dir" -b "$branch_name"

        for file in "${files_to_sync[@]}"; do
            if [[ -f "$original_repo/$file" ]]; then
                cp "$original_repo/$file" "$worktree_dir/$file"
                echo "Copied $file"
            fi
        done

        echo "Done. Worktree created at: $worktree_dir"
        exit 0
    fi
done

echo "Error: No available worktree slots (a-j)"
exit 1
