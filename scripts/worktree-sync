#!/bin/bash

set -euo pipefail

# 現在のgitリポジトリから元のリポジトリを特定
git_common_dir=$(git rev-parse --git-common-dir 2>/dev/null) || {
    echo "Error: Not in a git repository"
    exit 1
}
original_repo=$(cd "$git_common_dir" && cd .. && pwd)
parent_dir=$(dirname "$original_repo")
base_name=$(basename "$original_repo")

# Claude関連のファイル/ディレクトリをコピー
files_to_sync=(".mcp.json" "CLAUDE.local.md" ".env" ".env.common" ".envrc")
dirs_to_sync=(".claude")

if [[ -z "${1:-}" ]]; then
    echo "Usage: worktree-sync <branch_name>"
    exit 1
fi

branch_name="$1"

# 空いている連番を探す
for suffix in a b c d e f g h i j; do
    worktree_dir="$parent_dir/${base_name}-${suffix}"
    if [[ ! -d "$worktree_dir" ]]; then
        echo "Creating worktree at $worktree_dir for branch $branch_name..."

        # --no-checkout でworktreeを作成（post-checkoutフックが走らない）
        if git show-ref --verify --quiet "refs/heads/$branch_name"; then
            git worktree add --no-checkout "$worktree_dir" "$branch_name"
        else
            git worktree add --no-checkout "$worktree_dir" -b "$branch_name"
        fi

        # worktree側でhooksを無効化
        mkdir -p "$worktree_dir/.git-hooks-empty"
        git -C "$worktree_dir" config core.hooksPath "$worktree_dir/.git-hooks-empty"

        # checkoutを実行（hooksは無効化済み）
        echo "Checking out branch $branch_name..."
        git -C "$worktree_dir" checkout "$branch_name"

        # ファイルをコピー
        for file in "${files_to_sync[@]}"; do
            if [[ -f "$original_repo/$file" ]]; then
                cp "$original_repo/$file" "$worktree_dir/$file"
                echo "Copied $file"
            fi
        done

        # ディレクトリをコピー（既存があれば削除してから）
        for dir in "${dirs_to_sync[@]}"; do
            if [[ -d "$original_repo/$dir" ]]; then
                rm -rf "$worktree_dir/$dir"
                cp -r "$original_repo/$dir" "$worktree_dir/$dir"
                echo "Copied $dir/"
            fi
        done

        # 依存関係のインストール
        echo "Running pnpm install..."
        (cd "$worktree_dir" && pnpm install)

        echo "Running bundle install..."
        (cd "$worktree_dir" && bundle install)

        (cd "$worktree_dir" && direnv allow)

        # Dockerコンテナの起動とDBセットアップ
        echo "Docker compose up..."
        (cd "$worktree_dir" && bin/compose --profile core-backend-test up -d)

        echo "Waiting for docker compose to be ready..."
        max_attempts=60
        attempt=0
        while true; do
            # springコンテナがrunningになるまで待機
            if (cd "$worktree_dir" && bin/compose --profile core-backend-test ps --format json 2>/dev/null | jq -e 'select(.Service == "spring") | select(.State == "running")' > /dev/null 2>&1); then
                break
            fi
            attempt=$((attempt + 1))
            if [[ $attempt -ge $max_attempts ]]; then
                echo "Error: Docker compose did not start within ${max_attempts} seconds"
                exit 1
            fi
            echo "Waiting... ($attempt/$max_attempts)"
            sleep 1
        done
        echo "Docker compose is ready."

        echo "Creating tp database..."
        (cd "$worktree_dir" && bin/compose --profile core-backend-test exec -w /app spring spring rails db:create --database tp)

        echo "Loading tp database schema..."
        (cd "$worktree_dir" && bin/compose --profile core-backend-test exec -w /app spring spring rails db:schema:load --database tp)

        # post-checkoutフックがあればバックグラウンドで実行
        post_checkout_hook="$worktree_dir/.husky/post-checkout"
        if [[ -x "$post_checkout_hook" ]]; then
            echo "Running post-checkout hook in background..."
            (cd "$worktree_dir" && "$post_checkout_hook" "0000000000000000000000000000000000000000" "HEAD" "1") > /dev/null 2>&1 &
        fi

        echo "Done. Worktree created at: $worktree_dir"
        exit 0
    fi
done

echo "Error: No available worktree slots (a-j)"
exit 1
